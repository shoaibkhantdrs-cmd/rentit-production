<?xml version="1.0" encoding="UTF-8"?>
<!--
  RentIt: first draft static sitemap. Lists the pages that are genuinely
  public, content-bearing, and don't require sign-in (matches robots.txt's
  Allow/Disallow split). Individual property listing pages
  (/properties/:id) are deliberately NOT included here: they're real,
  valuable, indexable content, but this is a static frontend deploy
  (render.yaml runtime: static) with no server-side rendering step, so
  there's no build-time hook that can enumerate live listing IDs from the
  database into this file. Generating that requires a small backend
  endpoint (e.g. GET /properties/sitemap-ids, published listings only)
  feeding a dynamically built sitemap, a real follow-up, not done here to
  keep this change to the same "smallest correct fix" scope as the rest of
  this session's work.
-->
